---
const manifest = [
  { source: 'própria', permission: 'sim', use: 'treino' },
  { source: 'licenciada', permission: 'sim', use: 'treino' },
  { source: 'pública', permission: 'verificada', use: 'treino' },
  { source: 'sem permissão', permission: 'não', use: 'fora' },
];
---

<section id="topo" class="mx-auto max-w-6xl px-5 pb-20 pt-14 sm:px-8 sm:pb-24 sm:pt-20">
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-7">
      <p class="font-mono text-xs text-accent">fundação de pesquisa em IA · gti</p>

      <h1 class="mt-5 max-w-2xl font-display text-[clamp(2.75rem,7vw,4.75rem)] leading-[1.02] tracking-tight">
        Modelos justos começam na origem dos dados.
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
        Pesquisa independente em treinamento e inferência. Uso apenas conteúdo com permissão
        para treino, incluindo o meu. Refino modelos existentes e publico o que aprendo.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
        <a
          href="#projetos"
          class="inline-flex items-center gap-2 bg-ink px-5 py-3 text-sm font-medium text-paper hover:bg-accent"
        >
          Ver os projetos
          <span aria-hidden="true" class="font-mono">↗</span>
        </a>
        <a
          href="#metodo"
          class="text-sm text-ink underline decoration-line underline-offset-4 hover:decoration-accent"
        >
          Como eu trabalho
        </a>
      </div>
    </div>

    <div class="lg:col-span-5">
      <div class="border border-ink bg-ink p-5 text-paper sm:p-6">
        <div class="flex items-baseline justify-between border-b border-white/15 pb-4">
          <span class="font-mono text-xs">manifesto.de.dados</span>
          <span class="font-mono text-[10px] text-white/50">v1</span>
        </div>

        <dl class="mt-3">
          {manifest.map((row) => (
            <div
              class:list={[
                'grid grid-cols-[1fr_auto_auto] gap-x-5 gap-y-1 border-b border-white/10 py-2.5 text-sm last:border-0',
                row.use === 'fora' && 'opacity-50',
              ]}
            >
              <dt class="font-mono">{row.source}</dt>
              <dd class="font-mono text-white/55">{row.permission}</dd>
              <dd class="font-mono text-accent-light">{row.use}</dd>
            </div>
          ))}
        </dl>

        <p class="mt-4 border-t border-white/15 pt-4 font-mono text-xs text-white/60">
          → origem conhecida para cada exemplo
        </p>
      </div>
      <p class="mt-3 font-mono text-[11px] text-muted">
        Procedência antes de qualquer resultado.
      </p>
    </div>
  </div>
</section>
