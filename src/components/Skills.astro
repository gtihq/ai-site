---
const skills = [
  { name: 'bug-bounty', area: 'segurança', note: 'recon, validação e relato' },
  { name: 'osint-methodology', area: 'recon', note: 'superfície externa e fontes abertas' },
  { name: 'redteam-mindset', area: 'red team', note: 'disciplina de operação externa' },
  { name: 'security-audit', area: 'código', note: 'revisão defensiva de repositórios' },
  { name: 'web2-recon', area: 'recon', note: 'subdomínios, URLs e fuzzing' },
  { name: 'paseo', area: 'plataforma', note: 'agentes, workspaces e agendamentos' },
];
---

<section id="skills" class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <p class="font-mono text-xs text-accent">01 / skills</p>

    <div class="mt-5 flex flex-wrap items-end justify-between gap-6">
      <h2 class="max-w-xl font-display text-[clamp(2rem,4vw,3rem)] leading-tight tracking-tight">
        Instruções que moram com o código.
      </h2>
      <p class="max-w-md leading-relaxed text-muted">
        Cada skill é um diretório com instruções, exemplos e limites. O agente descobre
        pela estrutura, sem lista central.
      </p>
    </div>

    <ul class="mt-10 border-t border-line">
      {skills.map((skill) => (
        <li class="reveal grid gap-1 border-b border-line py-4 sm:grid-cols-[minmax(0,1fr)_7rem_minmax(0,1fr)] sm:items-baseline sm:gap-6">
          <span class="font-mono text-sm text-ink">{skill.name}</span>
          <span class="font-mono text-xs text-accent">{skill.area}</span>
          <span class="text-sm text-muted">{skill.note}</span>
        </li>
      ))}
    </ul>

    <a
      href="https://github.com/gtihq"
      target="_blank"
      rel="noopener noreferrer"
      class="mt-6 inline-flex items-center gap-2 text-sm text-ink underline decoration-line underline-offset-4 hover:decoration-accent"
    >
      Ver todas no GitHub
      <span aria-hidden="true" class="font-mono">↗</span>
    </a>
  </div>
</section>
