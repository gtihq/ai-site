---
import { translations } from '../i18n/ui';
import type { Language } from '../i18n/ui';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = translations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <div>
        <p class="flex items-baseline gap-2">
          <span class="text-2xl font-bold tracking-[-0.04em]">GTI</span>
          <span class="font-mono text-[11px] text-accent">/AI</span>
        </p>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted">{t.footer.tagline}</p>
      </div>

      <nav aria-label="Links do rodapé" class="flex flex-wrap gap-x-6 gap-y-3 text-sm">
        <a href="https://github.com/gtihq" target="_blank" rel="noopener noreferrer" class="text-muted hover:text-text">
          {t.footer.github}
        </a>
        <a href="/updates/index.json" class="text-muted hover:text-text">{t.footer.updates}</a>
        <a href="https://github.com/gtihq/ai-site/issues" target="_blank" rel="noopener noreferrer" class="text-muted hover:text-text">
          {t.footer.issues}
        </a>
      </nav>
    </div>

    <p class="mt-10 border-t border-line pt-5 font-mono text-xs text-muted">
      {t.footer.copyright.replace('2026', String(year))}
    </p>
  </div>
</footer>
