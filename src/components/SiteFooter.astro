---
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <div>
        <p class="flex items-baseline gap-2">
          <span class="font-display text-2xl leading-none">gti</span>
          <span class="font-mono text-xs text-accent">/ai</span>
        </p>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted">
          Pesquisa independente em IA, feita por uma pessoa.
        </p>
      </div>

      <nav aria-label="Links do rodapé" class="flex flex-wrap gap-x-6 gap-y-3 text-sm">
        <a href="https://github.com/gtihq" target="_blank" rel="noopener noreferrer" class="text-muted hover:text-ink">
          GitHub
        </a>
        <a href="/updates/index.json" class="text-muted hover:text-ink">Índice de atualizações</a>
        <a href="mailto:contato@gti.dev" class="text-muted hover:text-ink">Contato</a>
      </nav>
    </div>

    <p class="mt-10 border-t border-line pt-5 font-mono text-xs text-muted">
      © {year} GTI
    </p>
  </div>
</footer>
