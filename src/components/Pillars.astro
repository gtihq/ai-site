---
const pillars = [
  {
    index: '01',
    title: 'Skills',
    text: 'Instruções que agentes encontram por convenção, sem registro manual.',
    artifact: 'skills/<nome>/SKILL.md',
  },
  {
    index: '02',
    title: 'Servidores MCP',
    text: 'Conexões com ferramentas reais, cada uma com permissões explícitas.',
    artifact: 'mcp/<servidor>/index.ts',
  },
  {
    index: '03',
    title: 'Pesquisa',
    text: 'Treinamento com procedência, refino de modelos e estudo da inferência.',
    artifact: 'research/<experimento>.md',
  },
];
---

<section class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <p class="font-mono text-xs text-muted">três frentes, uma pesquisa</p>

    <div class="mt-8 grid gap-10 md:grid-cols-3 md:gap-8">
      {pillars.map((pillar) => (
        <div class="reveal border-t border-ink pt-5">
          <span class="font-mono text-xs text-accent">{pillar.index}</span>
          <h2 class="mt-4 font-display text-3xl">{pillar.title}</h2>
          <p class="mt-3 max-w-xs leading-relaxed text-muted">{pillar.text}</p>
          <p class="mt-6 font-mono text-[11px] text-muted">{pillar.artifact}</p>
        </div>
      ))}
    </div>
  </div>
</section>
