---
import { Container } from '@gtihq/shared-ui/core';
import { translations, localePath } from '../i18n/ui';
import type { Language } from '../i18n/ui';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = translations(lang);
const sections = [
  { href: '#incluido', label: t.nav.included },
  { href: '#modelos', label: t.nav.models },
  { href: '#metodo', label: t.nav.method },
  { href: '#atualizacoes', label: t.nav.updates },
];
---

<header class="sticky top-0 z-50 border-b border-line bg-canvas">
  <Container>
    <div class="flex h-16 items-center justify-between gap-4">
      <a href={localePath(lang)} class="flex items-baseline gap-2" aria-label="GTI AI">
        <span class="text-xl font-bold tracking-[-0.04em]">GTI</span>
        <span class="font-mono text-[11px] text-accent">/AI</span>
      </a>

      <nav aria-label="Navegação principal" class="hidden items-center gap-6 md:flex">
        {sections.map((section) => (
          <a href={section.href} class="text-sm text-muted transition-opacity hover:text-text">{section.label}</a>
        ))}
      </nav>

      <div class="flex items-center gap-4">
        <div class="flex items-center gap-1 font-mono text-xs" aria-label={t.nav.language}>
          <a href={localePath('pt')} hreflang="pt-BR" data-lang="pt" class:list={['hover:text-accent', lang === 'pt' ? 'text-accent' : 'text-muted']} aria-current={lang === 'pt' ? 'page' : undefined}>
            PT
          </a>
          <span class="text-line">/</span>
          <a href={localePath('en')} hreflang="en" data-lang="en" class:list={['hover:text-accent', lang === 'en' ? 'text-accent' : 'text-muted']} aria-current={lang === 'en' ? 'page' : undefined}>
            EN
          </a>
        </div>
        <a
          href="https://github.com/gtihq"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 border border-line px-3 py-1.5 text-xs hover:border-accent"
        >
          {t.nav.github}
          <span aria-hidden="true" class="font-mono">↗</span>
        </a>
      </div>
    </div>

    <nav aria-label="Seções" class="flex gap-5 border-t border-line py-2 font-mono text-xs text-muted md:hidden">
      {sections.map((section) => (
        <a href={section.href}>{section.label}</a>
      ))}
    </nav>
  </Container>
</header>
