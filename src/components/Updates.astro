---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

interface Update {
  date: string;
  title: string;
  summary: string;
  path: string;
}

const manifest = resolve(process.cwd(), 'public/updates/index.json');
const updates: Update[] = JSON.parse(readFileSync(manifest, 'utf-8'));
---

<section id="atualizacoes" class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <p class="font-mono text-xs text-accent">atualizações</p>

    <div class="mt-5 flex flex-wrap items-end justify-between gap-6">
      <h2 class="max-w-xl font-display text-[clamp(2rem,4vw,3rem)] leading-tight tracking-tight">
        O gti também publica aqui.
      </h2>
      <p class="max-w-md leading-relaxed text-muted">
        As próximas versões do gti serão servidas como arquivos estáticos neste domínio.
      </p>
    </div>

    <ul class="mt-10 border-t border-line">
      {updates.map((update) => (
        <li class="reveal grid gap-2 border-b border-line py-5 sm:grid-cols-[8rem_minmax(0,1fr)] sm:gap-6">
          <time datetime={update.date} class="font-mono text-xs text-muted">{update.date}</time>
          <div>
            <h3 class="font-display text-2xl leading-snug">{update.title}</h3>
            <p class="mt-2 max-w-2xl leading-relaxed text-muted">{update.summary}</p>
            <a href={update.path} class="mt-3 inline-block text-sm text-ink underline decoration-line underline-offset-4 hover:decoration-accent">
              Ler a nota
            </a>
          </div>
        </li>
      ))}
    </ul>

    <a
      href="/updates/index.json"
      class="mt-6 inline-flex items-center gap-2 text-sm text-ink underline decoration-line underline-offset-4 hover:decoration-accent"
    >
      Ver índice em JSON
      <span aria-hidden="true" class="font-mono">↗</span>
    </a>
  </div>
</section>
