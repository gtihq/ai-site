---
const servers = [
  { name: 'forgejo', note: 'repositórios, issues e releases' },
  { name: 'plane', note: 'projetos e tarefas' },
  { name: 'mercadolivre', note: 'pedidos e frete' },
  { name: 'shopee', note: 'categorias e tendências' },
  { name: 'kabum', note: 'produtos e CEP' },
  { name: 'twitter', note: 'tendências e busca' },
];
---

<section id="mcp" class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <p class="font-mono text-xs text-accent">02 / mcp</p>

    <div class="mt-5 flex flex-wrap items-end justify-between gap-6">
      <h2 class="max-w-xl font-display text-[clamp(2rem,4vw,3rem)] leading-tight tracking-tight">
        Agentes com acesso a ferramentas reais.
      </h2>
      <p class="max-w-md leading-relaxed text-muted">
        Cada servidor MCP expõe só o necessário, com permissões explícitas e nada escondido.
      </p>
    </div>

    <div class="mt-10 border border-ink bg-ink p-5 text-paper sm:p-7">
      <p class="font-mono text-xs text-white/50"><span class="text-accent-light">$</span> gti mcp list</p>

      <ul class="mt-5 border-t border-white/15">
        {servers.map((server) => (
          <li class="reveal grid gap-1 border-b border-white/10 py-2.5 font-mono text-sm last:border-0 sm:grid-cols-[12rem_minmax(0,1fr)] sm:gap-6">
            <span class="text-paper">{server.name}</span>
            <span class="text-white/55">{server.note}</span>
          </li>
        ))}
      </ul>

      <p class="mt-5 font-mono text-[11px] text-white/50">
        a lista completa fica no repositório
      </p>
    </div>

    <a
      href="https://github.com/gtihq"
      target="_blank"
      rel="noopener noreferrer"
      class="mt-6 inline-flex items-center gap-2 text-sm text-ink underline decoration-line underline-offset-4 hover:decoration-accent"
    >
      Ver servidores
      <span aria-hidden="true" class="font-mono">↗</span>
    </a>
  </div>
</section>
