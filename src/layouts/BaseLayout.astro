---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { translations } from '../i18n/ui';
import type { Language } from '../i18n/ui';

interface Props {
  lang: Language;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const t = translations(lang);
const canonical = lang === 'pt' ? 'https://ai.gti.dev/' : 'https://ai.gti.dev/en/';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0b0d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href="https://ai.gti.dev/" />
    <link rel="alternate" hreflang="en" href="https://ai.gti.dev/en/" />
    <link rel="alternate" hreflang="x-default" href="https://ai.gti.dev/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
    <script is:inline src="/reveal.js"></script>
  </head>
  <body class="min-h-screen bg-canvas text-text">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:bg-accent focus:px-3 focus:py-2 focus:text-sm focus:text-canvas"
    >
      {t.nav.skip}
    </a>
    <SiteHeader lang={lang} />
    <main id="conteudo">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
